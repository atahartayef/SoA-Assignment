{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.maltashop.mt/order-confirmed.v1.schema.json",
  "title": "OrderConfirmed v1",
  "description": "Published by order-service on maltashop.order.confirmed. The consumer (notification-service) owns this file; the provider's pipeline must keep it green.",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "correlation_id", "producer", "data"],
  "properties": {
    "event_id":       { "type": "string", "minLength": 36 },
    "event_type":     { "const": "OrderConfirmed" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "occurred_at":    { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id":   { "type": "string" },
    "producer":       { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "required": ["order_id", "customer_id", "total_cents", "lines"],
      "properties": {
        "order_id":    { "type": "string", "minLength": 36 },
        "customer_id": { "type": "string", "minLength": 1 },
        "total_cents": { "type": "integer", "minimum": 0 },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "properties": {
              "sku":      { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
