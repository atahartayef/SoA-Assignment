# Copy to .env before `docker compose up`. These are development values only.
# In staging and production every one of them is injected by AWS Systems Manager
# Parameter Store at task start; none is ever written to a file in the repository.

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
LOG_LEVEL=info                        # debug | info | warn | error
SERVICE_VERSION=0.6.1

# --- messaging ---------------------------------------------------------------
NATS_URL=nats://nats:4222             # one JetStream server; three in production

# --- datastore passwords, one per service ------------------------------------
ORDER_DB_PASSWORD=order_dev_pw
INVENTORY_DB_PASSWORD=inventory_dev_pw
PAYMENT_DB_PASSWORD=payment_dev_pw

# --- behaviour ---------------------------------------------------------------
OUTBOX_POLL_MS=350                    # how often the outbox leader drains the table
CARD_LIMIT_EUR=750                    # the stubbed provider declines above this
